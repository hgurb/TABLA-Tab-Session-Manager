{
  "manifest_version": 3,
  "name": "TABLA Tab & Session Manager",
  "version": "1.0.0",
  "description": "Automatic tab grouping by domain or source, saved sessions, and local group recovery across restarts.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "contextMenus",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TABLA Tab & Session Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "group-window": {
      "description": "Group the current window using the toolbar setting"
    },
    "undo-grouping": {
      "description": "Undo the last grouping change in this window"
    }
  }
}
